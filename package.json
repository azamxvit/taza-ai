    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "i18next": "^27.2.2",
    "leaflet": "^1.9.4",
    "lucide": "^1.77.0",
    "lucide-react": "^1.77.0",
    "mongodb": "^6.16.0",
    "multer": "^2.0.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^18.0.3",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.1.1",
