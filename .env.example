# ─────────────────────────────────────────────────────────────
# Taza AI — пример переменных окружения.
# Скопируй в server/.env (бэкенд) и .env (фронт) и заполни.
# Настоящие .env-файлы в git НЕ коммитятся (.gitignore).
# ─────────────────────────────────────────────────────────────

# --- Бэкенд (server/.env или Environment на Render) ---

# MongoDB Atlas (бесплатный кластер M0). Если пусто и NODE_ENV != production,
# сервер поднимет временную MongoDB в памяти (данные пропадут после перезапуска).
MONGODB_URI=
MONGODB_DB=tazaai

# Google Gemini (ключ из https://aistudio.google.com/apikey, free tier)
GEMINI_API_KEY=
# Модель семейства Flash; точный ID сверь в AI Studio (gemini-2.5-flash новым ключам уже недоступна)
GEMINI_MODEL=gemini-3.8-flash
# Запасные модели через запятую: если основная перегружена или не ответила за 20 с
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# NASA FIRMS (бесплатно: https://firms.modaps.eosdis.nasa.gov/api/map_key)
FIRMS_MAP_KEY=

# Адрес сайта для ссылки на жалобу в тексте обращения (на Vercel: https://<проект>.vercel.app)
PUBLIC_SITE_URL=
# Соль для хэша id устройства (подтверждения «Устранено»). На Render задай любую случайную строку.
CLIENT_ID_SALT=

# Разрешённые фронтенд-домены через запятую, без слэша на конце
CORS_ORIGINS=http://localhost:5173

# Порт API (5000 на macOS занят AirPlay, поэтому 5050)
PORT=5050

# --- Необязательно: постоянное хранилище фото (Cloudflare R2 / Supabase, S3-совместимые) ---
# Без них фото лежат на диске сервера (на бесплатном Render стираются при редеплое).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Фронтенд (.env в корне или Environment на Vercel) ---
# Адрес бэкенда. Локально оставь пустым: Vite проксирует /api на :5050.
VITE_API_URL=
