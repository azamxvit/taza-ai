# --- Backend (server/.env or Render env) ---

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGODB_DB=cleancity

# Comma-separated list of allowed frontend origins (no spaces after commas)
# Must match your Vercel domain exactly (NO trailing slash).
CORS_ORIGINS=https://clean-city-report.vercel.app

# --- Optional: Object storage for permanent, free image hosting ---
# Set ALL of these to store uploads in Cloudflare R2 or Supabase Storage
# (both are S3-compatible). When set, images survive redeploys forever.
# Leave blank to use local disk (ephemeral on Render free tier).
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=clean-city
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_PUBLIC_URL=https://pub-<hash>.r2.dev

# --- Frontend (Vercel env) ---
# The backend base URL (Vite bakes this in at build time — redeploy after changing)
VITE_API_URL=https://clean-city-api.onrender.com
